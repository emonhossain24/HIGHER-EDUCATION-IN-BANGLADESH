PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
DATA_DIR=./var
# Production requires HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false
# Required for signup verification and password recovery. An HTTPS endpoint
# receiving {to,subject,text}; supports an Authorization Bearer token.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Enable only in an isolated local development environment. Never on a public host.
DEV_MAIL=false
# PDF uploads require a working clamscan executable; images use magic-byte validation.
CLAMSCAN_PATH=

# ImageMagick decoder used to strip metadata, bound dimensions and reencode images.
IMAGE_CONVERT_PATH=magick
